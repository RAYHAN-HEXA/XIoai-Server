# XiaoCai API — copy to .env and fill real values. NEVER commit .env.

NODE_ENV=development
PORT=4000

# Neon Postgres. Keep sslmode=require.
# If Prisma/pg complains, remove &channel_binding=require from the URL.
# NOTE: when the host is *.neon.tech the API automatically connects over
# HTTPS 443 (Neon WebSocket driver) — immune to networks that block port 5432.
# Non-Neon hosts (e.g. the local embedded pg) use plain TCP automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Generate with: openssl rand -hex 32  (must be ≥32 chars)
JWT_SECRET="replace-with-a-long-random-string-32-chars-min"

# Comma-separated list of allowed web origins (CORS, credentials enabled)
WEB_ORIGIN="http://localhost:3000"

# OPTIONAL. The app is fully functional with the LLM disabled.
# When set, the assistant can parse what-if questions and write explanations;
# the deterministic engine still produces every number.
# Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY="AIza..."

# OPTIONAL. Rate limiters are ON by default. Set to "0" only for local
# integration tests — never in production.
# RATE_LIMIT_ENABLED="0"
